<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext HTTP only for the Android emulator's loopback
  alias (10.0.2.2) and localhost, so the demo can talk to a local
  Surfpool RPC and the companion merchant server during development.
  All other destinations remain HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
