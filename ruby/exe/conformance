#!/usr/bin/env ruby
# frozen_string_literal: true

# Ruby cross-SDK conformance-vector runner.
#
# Honors the same stdin/stdout contract as the TypeScript reference runner
# (harness/src/conformance/ts-runner.ts): read one conformance vector as JSON
# on stdin, drive the real Ruby solana-pay-kit SDK for the requested mode, and
# emit one RunnerResult line as JSON on stdout.
#
# ROLE: ruby is SERVER-only. The SDK ships a pre-broadcast charge verifier
# (PayKit::Protocols::Mpp::Protocol::Solana::Verifier), the x402 exact server
# verifier (PayKit::Protocols::X402::Server::Exact.verify_exact_payment) and the
# wire canonical-JSON / base64url encoders, but NO client-side transaction
# builder. So this runner:
#
#   - canonical-bytes      -> PayCore::Json + PayCore::Base64Url + Challenge.
#   - verify-transaction   -> the real charge Verifier over the vector's pinned
#                             transaction, with the request passed verbatim.
#                             A vector with no pinned transaction needs a
#                             client build first, so it is unsupported here:
#                             the runner never fabricates a transaction.
#   - x402-exact (verify)  -> the real x402 server verifier (version dispatch,
#                             requirement binding, structural transaction
#                             checks, client signatures) against a server
#                             Config built from the vector route and the
#                             fixture RPC. Pre-broadcast only: nothing is
#                             signed or sent.
#   - build-transaction    -> unsupported-mode (no client builder).
#
# The runner never fills defaults, resolves token programs or decimals, or
# applies field precedence: chain state comes from the fixture RPC at
# input.rpcUrl, and whatever the SDK does with an omitted field is what the
# vector judges (harness/expectations/RULINGS.md).

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "base64"
require "json"
require "pay_kit"

TOKEN_PROGRAM = PayCore::Solana::Programs::TOKEN_PROGRAM
TOKEN_2022_PROGRAM = PayCore::Solana::Programs::TOKEN_2022_PROGRAM
SYSTEM_PROGRAM = PayCore::Solana::Programs::SYSTEM_PROGRAM
COMPUTE_BUDGET_PROGRAM = PayCore::Solana::Programs::COMPUTE_BUDGET_PROGRAM
MEMO_PROGRAM = PayCore::Solana::Programs::MEMO_PROGRAM

SERVER_ONLY_BUILD = "ruby SDK is server-only: build-transaction has no client builder"
SERVER_ONLY_X402_BUILD = "ruby SDK is server-only: x402 build-transaction has no client builder"
NO_PINNED_TRANSACTION = "ruby SDK is server-only: this verify vector pins no transaction, " \
  "so it needs a client build first and ruby has no client builder"

def unsupported(id, reason)
  {"id" => id, "outcome" => "unsupported-mode", "error" => reason}
end

# Decode a wire transaction into the semantic shape the driver asserts.
# Mirrors the TS reference decoder (decode.ts).
def shape_from_transaction(transaction_base64)
  tx = PayCore::Solana::Transaction.from_base64(transaction_base64)
  keys = tx.message.account_keys
  shape = {
    "feePayer" => keys.first,
    "forbiddenPrograms" => [],
    "transfers" => [],
    "memo" => []
  }

  tx.message.instructions.each do |ix|
    program = keys.fetch(ix.program_id_index)
    data = ix.data

    case program
    when COMPUTE_BUDGET_PROGRAM
      if data.bytesize == 5 && data.getbyte(0) == 2
        shape["maxComputeUnitLimit"] = data.byteslice(1, 4).unpack1("L<")
      elsif data.bytesize == 9 && data.getbyte(0) == 3
        shape["maxComputeUnitPrice"] = data.byteslice(1, 8).unpack1("Q<").to_s
      end
    when MEMO_PROGRAM
      shape["memo"] << data.dup.force_encoding("UTF-8")
    when SYSTEM_PROGRAM
      if data.bytesize >= 12 && data.byteslice(0, 4).unpack1("L<") == 2
        shape["transfers"] << {
          "kind" => "sol",
          "destination" => keys[ix.accounts[1]],
          "amount" => data.byteslice(4, 8).unpack1("Q<").to_s
        }
      end
    when TOKEN_PROGRAM, TOKEN_2022_PROGRAM
      if data.bytesize >= 10 && data.getbyte(0) == 12 && ix.accounts.length >= 4
        shape["transfers"] << {
          "kind" => "spl",
          "destination" => keys[ix.accounts[2]],
          "mint" => keys[ix.accounts[1]],
          "amount" => data.byteslice(1, 8).unpack1("Q<").to_s,
          "decimals" => data.getbyte(9),
          "tokenProgram" => program
        }
      end
    end
  end

  shape
end

# Map the SDK's native reject message onto the shared RejectCode vocabulary
# (mirrors harness/src/conformance/reject.ts). Returns nil when no pattern
# matches so the harness surfaces an unclassified rejection.
#
# The charge verifier enforces transferChecked decimals through the transfer
# match key, so a decimals mismatch surfaces as "no matching transfer".
REJECT_PATTERNS = [
  # Charge verification policy and client challenge checks (mirrors the
  # block at the top of harness/src/conformance/reject.ts).
  [/fee payer (token account )?cannot fund/i, "fee-payer-is-funds-source"],
  [/primary amount is zero after splits|split amounts exceed/i, "splits-exceed-amount"],
  [/splits exceed maximum/i, "too-many-splits"],
  [/ata creation owner is not authorized|unsupported compute budget|unexpected_signer/i, "unexpected-instruction"],
  [/atacreationrequired requires|unsupported challenge network|invalid amount|requires feepayerkey/i, "invalid-challenge"],
  [/ata creation|ata payer|transaction fee payer (must be|mismatch)|memo cannot exceed/i, "invalid-payload"],
  # x402 v2: the credential's `accepted` matches no offered requirement.
  [/No matching payment requirements|accepted payment requirement does not match/i, "accepted-mismatch"],
  [/no memo instruction found|memo_mismatch|memo_count/i, "invalid-payload"],
  [/unsupported x402\s*version/i, "unsupported-version"],
  [/network mismatch/i, "wrong-network"],
  [/payment.identifier .*(required|missing|invalid)/i, "payment-identifier-required"],
  [/compute unit price .* exceeds (maximum|cap)/i, "compute-price-over-cap"],
  [/compute_price_instruction_too_high/i, "compute-price-over-cap"],
  [/compute unit limit .* exceeds (maximum|cap)/i, "compute-limit-over-cap"],
  [/fee payer cannot authorize/i, "fee-payer-not-authority"],
  [/fee_payer_transferring_funds|fee_payer_in_instruction_accounts/i, "fee-payer-not-authority"],
  [/fee payer .* (funding source|funds source|fund the)/i, "fee-payer-is-funds-source"],
  [/splits consume the entire amount|split amounts exceed/i, "splits-exceed-amount"],
  [/too many splits/i, "too-many-splits"],
  [/no matching (spl )?(transfer|transferchecked|sol transfer)|no_transfer_instruction|recipient_mismatch|mint_mismatch/i, "no-matching-transfer"],
  [/amount_mismatch|amount .* (mismatch|does not match)/i, "amount-mismatch"],
  [/unexpected .* (instruction|transfer)|unknown_(fourth|fifth|sixth|optional)_instruction/i, "unexpected-instruction"]
].freeze

def classify_reject(message)
  return nil if message.to_s.empty?

  REJECT_PATTERNS.each { |pattern, code| return code if pattern.match?(message) }
  return "invalid-payload" if /invalid|malformed|decode|payload/i.match?(message)

  nil
end

def reject_result(id, message)
  result = {"id" => id, "outcome" => "reject", "error" => message}
  code = classify_reject(message)
  result["rejectCode"] = code if code
  result
end

# ── x402 `exact` ──

# Decode a base64(JSON) envelope header into the conformance shape oracle
# (mirrors decodeEnvelopeShape in harness/src/conformance/x402.ts). This only
# reports what was accepted; the accept decision itself is the SDK's.
def x402_envelope_shape(header)
  env = JSON.parse(Base64.decode64(header.to_s))
  accepted = env["accepted"]
  payload = env["payload"]
  tx = payload.is_a?(Hash) ? payload["transaction"] : nil

  shape = {
    "x402Version" => env["x402Version"],
    "hasAccepted" => !accepted.nil?,
    "payloadHasTransaction" => tx.is_a?(String) && !tx.empty?
  }
  shape["scheme"] = env["scheme"] if env.key?("scheme")
  shape["network"] = env["network"] if env.key?("network")
  if accepted.is_a?(Hash)
    shape["acceptedScheme"] = accepted["scheme"]
    shape["acceptedNetwork"] = accepted["network"]
    shape["acceptedAsset"] = accepted["asset"]
    shape["acceptedPayTo"] = accepted["payTo"]
    shape["acceptedAmount"] = accepted["amount"]
  end

  extensions = env["extensions"]
  if extensions.is_a?(Hash)
    keys = extensions.keys.sort
    shape["hasExtensions"] = !keys.empty?
    shape["extensionKeys"] = keys
    pid = extensions[PayKit::Protocols::X402::Protocol::Schemes::Exact::PAYMENT_IDENTIFIER_KEY]
    shape["hasPaymentIdentifier"] = !pid.nil?
    info = pid.is_a?(Hash) ? pid["info"] : nil
    if info.is_a?(Hash)
      shape["paymentIdentifierRequired"] = info["required"] unless info["required"].nil?
      shape["paymentIdentifierId"] = info["id"] unless info["id"].nil?
    end
  else
    shape["hasExtensions"] = false
    shape["hasPaymentIdentifier"] = false
    shape["extensionKeys"] = []
  end
  shape
end

def run_x402_vector(vector)
  input = vector["input"] || {}
  return unsupported(vector["id"], SERVER_ONLY_X402_BUILD) if vector["mode"] == "build-transaction"

  header = input["x402PaymentHeader"]
  raise "invalid payload: x402 verify vector missing input.x402PaymentHeader" if header.to_s.empty?

  %w[x402ServerNetwork x402ServerRecipient x402ServerCurrency x402ServerAmount x402ServerFeePayerSecretKey rpcUrl].each do |key|
    raise "x402 verify vector missing input.#{key}" if input[key].nil?
  end

  # The server's route, configured the way a production caller would. The
  # network is the cluster slug normalized by the SDK's CAIP-2 mapper.
  config = PayKit::Protocols::X402::Server::Exact::Config.new(
    rpc_url: input["rpcUrl"],
    network: PayCore::Solana::Caip2.for_cluster(input["x402ServerNetwork"]),
    mint: input["x402ServerCurrency"],
    pay_to: input["x402ServerRecipient"],
    amount: input["x402ServerAmount"],
    facilitator_secret_key: JSON.generate(input["x402ServerFeePayerSecretKey"]),
    payment_identifier_required: input["x402ServerRequiresPaymentIdentifier"] == true
  )

  begin
    # The route's extra.memo is the SDK's resource binding (`resource:`):
    # it is advertised as extra.memo and enforced on the transaction.
    memo = input["x402ServerMemo"]
    PayKit::Protocols::X402::Server::Exact.verify_exact_payment(config, header, resource: memo)
  rescue => error
    return reject_result(vector["id"], error.message)
  end

  {"id" => vector["id"], "outcome" => "accept", "x402EnvelopeShape" => x402_envelope_shape(header)}
end

# ── canonical bytes ──

def run_canonical_bytes(vector)
  input = vector["input"] || {}
  exact = {}
  if input.key?("value")
    canonical = PayCore::Json.canonical_generate(input["value"])
    exact["canonicalJson"] = canonical
    exact["base64Url"] = PayCore::Base64Url.encode(canonical)
  end
  if (enc = input["encodeBase64Url"])
    if enc["hexBytes"]
      bytes = [enc["hexBytes"]].pack("H*")
      exact["bytes"] = bytes.bytes
      exact["base64Url"] = PayCore::Base64Url.encode(bytes)
    elsif enc["utf8"]
      exact["base64Url"] = PayCore::Base64Url.encode(enc["utf8"])
    end
  end
  if (cid = input["challengeId"])
    exact["base64Url"] = PayKit::Protocols::Mpp::Protocol::Core::Challenge.compute_id(
      secret_key: cid["secretKey"],
      realm: cid["realm"],
      method: cid["method"],
      intent: cid["intent"],
      request: cid["request"],
      expires: cid["expires"],
      digest: cid["digest"],
      opaque: cid["opaque"]
    )
  end
  {"id" => vector["id"], "outcome" => "accept", "exactBytes" => exact}
end

# ── charge verify ──

def run_verify_transaction(vector)
  input = vector["input"] || {}
  request = input["request"]
  raise "verify vector is missing input.request" unless request

  tx = input["transaction"]
  return unsupported(vector["id"], NO_PINNED_TRANSACTION) if tx.to_s.empty?

  charge_request = PayKit::Protocols::Mpp::Protocol::Intents::ChargeRequest.from_h(request)
  result = PayKit::Protocols::Mpp::Protocol::Solana::Verifier.new.verify_transaction_payload(tx, charge_request)
  return reject_result(vector["id"], result.reason) unless result.ok?

  {"id" => vector["id"], "outcome" => "accept", "transactionShape" => shape_from_transaction(tx)}
end

def run_vector(vector)
  return run_x402_vector(vector) if vector["intent"] == "x402-exact"

  case vector["mode"]
  when "canonical-bytes"
    run_canonical_bytes(vector)
  when "verify-transaction"
    run_verify_transaction(vector)
  when "build-transaction"
    unsupported(vector["id"], SERVER_ONLY_BUILD)
  else
    reject_result(vector["id"], "unsupported mode #{vector["mode"]}")
  end
end

def result_for(vector)
  run_vector(vector)
rescue => error
  reject_result(vector["id"], error.message)
end

# Intents this runner implements; pkc checks them against
# harness/expectations/ruby.toml.
INTENTS = %w[charge x402-exact].freeze

# Testee ABI v2 (harness/README.md): newline JSON {id, op, input} in,
# {id, ok, result | error} out, one long-lived process. `input` is the v1
# vector and `result` the v1 RunnerResult.
def serve
  $stdout.sync = true
  $stdin.each_line do |line|
    next if line.strip.empty?

    response =
      begin
        request = JSON.parse(line)
        case request["op"]
        when "capabilities"
          {"id" => request["id"], "ok" => true,
           "result" => {"abi" => 2, "language" => "ruby", "intents" => INTENTS, "honoursClock" => false}}
        when "build", "verify", "canonical-bytes"
          {"id" => request["id"], "ok" => true, "result" => result_for(request["input"] || {})}
        else
          {"id" => request["id"], "ok" => false, "error" => "unknown-op", "detail" => request["op"].to_s}
        end
      rescue JSON::ParserError => error
        {"id" => nil, "ok" => false, "error" => "bad-request", "detail" => error.message}
      end
    $stdout.puts(JSON.generate(response))
  end
end

if ARGV.include?("--serve")
  serve
else
  raw = $stdin.read.to_s.strip
  abort "ruby conformance runner received empty stdin" if raw.empty?
  $stdout.puts(JSON.generate(result_for(JSON.parse(raw))))
end
