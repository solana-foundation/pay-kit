{
    "name": "@solana/pay-kit",
    "version": "0.7.0",
    "description": "Building blocks for Agentic payments (x402, MPP, AP2)",
    "repository": {
        "type": "git",
        "url": "https://github.com/solana-foundation/pay-kit",
        "directory": "typescript/packages/pay-kit"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "default": "./dist/client/index.js"
        }
    },
    "files": [
        "dist",
        "src/[!_]*"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\""
    },
    "dependencies": {
        "@solana-program/compute-budget": "^0.15.0",
        "@solana-program/token": "^0.13.0",
        "@solana-program/token-2022": "^0.11.0",
        "@solana/keychain-memory": "^1.3.0",
        "@solana/kit": ">=6.5.0",
        "mppx": ">=0.5.5"
    },
    "devDependencies": {
        "@solana/mpp": "workspace:^",
        "@types/node": "^25.5.0",
        "@x402/core": "file:../../.x402-vendor/x402-core-2.16.0.tgz",
        "@x402/svm": "file:../../.x402-vendor/x402-svm-2.16.0-paykit.2.tgz",
        "tsup": "^8.5.0"
    }
}
