{
    "name": "@solana/pay-kit",
    "version": "0.1.0",
    "description": "Protocol-agnostic payment gating for HTTP services on Solana",
    "repository": {
        "type": "git",
        "url": "https://github.com/solana-foundation/pay-kit",
        "directory": "typescript/packages/pay-kit"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "default": "./dist/client/index.js"
        }
    },
    "files": [
        "dist",
        "src/[!_]*"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@solana-program/compute-budget": "^0.11.0",
        "@solana-program/token": "^0.9.0",
        "@solana-program/token-2022": "^0.6.1",
        "@solana/keychain-memory": "^1.3.0"
    },
    "peerDependencies": {
        "@solana/kit": ">=6.5.0",
        "@solana/mpp": ">=0.6.0",
        "mppx": ">=0.5.5"
    },
    "devDependencies": {
        "@solana/kit": "^6.5.0",
        "@solana/mpp": "workspace:^",
        "@types/node": "^25.5.0",
        "@x402/core": "file:../../.x402-vendor/x402-core-2.16.0.tgz",
        "@x402/svm": "file:../../.x402-vendor/x402-svm-2.16.0.tgz",
        "mppx": "^0.5.5",
        "tsup": "^8.5.0"
    }
}
