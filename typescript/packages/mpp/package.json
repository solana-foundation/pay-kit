{
  "name": "@solana/mpp",
  "version": "0.8.0",
  "description": "Solana payment method for the MPP protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/solana-foundation/pay-kit",
    "directory": "typescript/packages/mpp"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src/[!_]*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.11.0",
    "@solana/program-client-core": "^6.10.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@solana/kit": ">=6.10.0",
    "mppx": ">=0.5.5"
  },
  "devDependencies": {
    "@solana/kit": "^6.10.0",
    "@solana/kit-client-rpc": "^0.8.0",
    "@types/node": "^25.5.0",
    "mppx": "^0.8.15",
    "surfpool-sdk": "^1.2.0",
    "tsx": "^4.19.0"
  }
}
