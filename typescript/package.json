{
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:surfpool": "vitest run --config vitest.config.surfpool.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/*/src --ext .ts",
    "lint:fix": "eslint packages/*/src --ext .ts --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "docs": "typedoc",
    "docs:html": "typedoc --options typedoc.html.json",
    "docs:serve": "typedoc --options typedoc.html.json && npx -y serve ../docs/api/typescript-html",
    "docs:watch": "typedoc --watch"
  },
  "prettier": "@solana/prettier-config-solana",
  "pnpm": {
    "overrides": {
      "ws": "^8.21.0",
      "@x402/core": "file:.x402-vendor/x402-core-2.16.0.tgz",
      "@hono/node-server": ">=1.19.13",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.25",
      "ip-address": ">=10.1.1",
      "js-yaml": ">=4.2.0",
      "path-to-regexp": ">=8.4.0",
      "qs": ">=6.15.2",
      "yaml": ">=2.8.3"
    }
  },
  "devDependencies": {
    "@solana/eslint-config-solana": "^6.0.0",
    "@solana/prettier-config-solana": "^0.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.0"
  }
}
