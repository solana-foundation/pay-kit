parameters:
    level: 3
    paths:
        - src
        - tests
        - examples/simple-server
        - ../harness/php-server
    excludePaths:
        # Laravel adapter requires illuminate/* which is not in dev
        # deps; analysed under the consumer app, not here.
        - src/Frameworks/Laravel/*
        - src/Frameworks/Laravel/**
        # Symfony adapter is analysed under the consumer app via the
        # symfony/* deps that come with it. The bundle wiring uses
        # container dynamics that PHPStan can't follow without the
        # full Symfony kernel.
        - src/Frameworks/Symfony/*
        - src/Frameworks/Symfony/**
    treatPhpDocTypesAsCertain: false
    # Surface ignore-path drift instead of swallowing it: the
    # SchemesProtocols rename left the old ignoreErrors entries
    # pointing at directories that no longer exist, and a level-3
    # rerun on the renamed handlers reports no errors, so every
    # suppression had become dead config. Keeping this true means any
    # future regression that needs a suppression must add a matching
    # entry rather than silently relying on a stale one.
    reportUnmatchedIgnoredErrors: true
    bootstrapFiles:
        - vendor/autoload.php
