{
  "name": "solana-foundation/mpp-sdk-php",
  "description": "Server-side PHP helpers for the MPP protocol.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "SolanaMpp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SolanaMpp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
