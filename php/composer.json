{
  "name": "solana/pay-sdk",
  "description": "Server-side PHP helpers for the MPP protocol.",
  "type": "library",
  "license": "MIT",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/SolDapper/solana-php"
    }
  ],
  "require": {
    "php": "^8.1",
    "solana-php/solana-sdk": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "SolanaMpp\\": "src/",
      "SolanaMpp\\X402\\": "src/x402/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SolanaMpp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no --sequential",
    "lint:syntax": "find src tests examples ../harness/php-server \\( -path examples/laravel -prune \\) -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:static": "phpstan analyse --debug --memory-limit=1G",
    "lint": [
      "@lint:syntax",
      "@format:check",
      "@lint:static"
    ],
    "test": [
      "@test:mpp",
      "@test:x402"
    ],
    "test:mpp": "phpunit",
    "test:x402": "php tests/x402_interop_server_test.php",
    "test:coverage": "phpunit --coverage-clover build/coverage/clover.xml --coverage-text && php scripts/check_coverage.php build/coverage/clover.xml 90"
  },
  "config": {
    "platform": {
      "php": "8.3.31"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
