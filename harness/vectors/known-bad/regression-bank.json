{
  "schemaVersion": 1,
  "ownerLane": "regression-vectors",
  "description": "Known-bad negative regression bank. Entries may be schema repros before a full signed artifact exists; each escaped bug graduates to an executable vector when practical.",
  "vectors": [
    {
      "id": "known-bad-x402-wrong-network",
      "protocol": "x402-exact",
      "ownerLane": "regression-vectors",
      "artifactKind": "schema-repro",
      "bugClass": "wrong-network",
      "labels": ["known-bad", "negative", "wrong-network"],
      "summary": "Credential accepted for devnet must not satisfy a localnet route.",
      "minimalRepro": {
        "route": {
          "method": "POST",
          "path": "/checkout/pay",
          "network": "solana:localnet",
          "asset": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",
          "amount": "1000",
          "payTo": "J2xccRtuG43drESLYznHhLhQkLTdfepcKYbiQ9BsJVaf"
        },
        "submittedCredential": {
          "x402Version": 2,
          "accepted": {
            "scheme": "exact",
            "network": "solana:devnet",
            "asset": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",
            "amount": "1000",
            "payTo": "J2xccRtuG43drESLYznHhLhQkLTdfepcKYbiQ9BsJVaf"
          },
          "payload": {
            "transaction": "<signed-transaction-for-devnet-offer>"
          }
        }
      },
      "expected": {
        "status": "reject",
        "httpStatus": 402,
        "rejectionClass": "wrong-network",
        "runnerRejectCode": "wrong-network"
      }
    },
    {
